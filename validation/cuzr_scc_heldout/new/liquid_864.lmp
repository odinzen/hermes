# Liquid Cu-Zr trajectory + enthalpy for the entropy estimators (Mendelev 2009 EAM).
# Copy of md_liquid.lmp (station2 binary_cuzr_eam) that starts from a random 864-atom fcc of the given Zr count
# and writes the final liquid for calphy.
# lmp -var tag <name> -var nzr <Zr atoms> -var lseed <label seed> -var T 2300 -var pot <eam.fs> -in liquid_864.lmp
units metal
atom_style atomic
boundary p p p
lattice fcc 4.07
region box block 0 6 0 6 0 6
create_box 2 box
create_atoms 1 box
mass 1 63.546
mass 2 91.224
set type 1 type/subset 2 ${nzr} ${lseed}
pair_style eam/fs
pair_coeff * * ${pot} Cu Zr
timestep 0.001
velocity all create 3500 4928 mom yes dist gaussian

# melt, then find the zero-pressure volume at T
fix 1 all npt temp 3500 ${T} 0.1 iso 0 0 1.0
run 10000
fix 1 all npt temp ${T} ${T} 0.1 iso 0 0 1.0
run 20000
variable L equal lx
fix av all ave/time 10 1000 20000 v_L
run 20000
variable Lm equal f_av
variable Lfix equal ${Lm}
print "mean_box_length ${Lfix}"
unfix av
unfix 1
change_box all x final 0 ${Lfix} y final 0 ${Lfix} z final 0 ${Lfix} remap units box

# production NVT at the mean volume: frames every 0.5 ps for 60 ps
fix 2 all nvt temp ${T} ${T} 0.1
run 10000
reset_timestep 0  # aligns the production averaging window with step 0
compute msd all msd
thermo_style custom step temp pe press vol c_msd[4]
thermo 5000
variable pe equal pe/atoms
variable p equal press
fix th all ave/time 10 6000 60000 v_pe v_p file ${tag}_thermo.dat
dump d all custom 500 ${tag}.dump id type x y z
dump_modify d sort id
run 60000
write_data liq_${tag}.data
